    .site-footer {
      margin-top: 30px;
      padding: 22px;
      text-align: center;
      color: #6b5b20;
      border-top: 1px solid #eadb9b;
    }

    @media (max-width: 600px) {
      main {
        width: 94%;
        margin-top: 18px;
      }

      .controls {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }

      #counter {
        grid-column: 1 / -1;
        grid-row: 1;
        text-align: center;
      }

      button {
        width: 100%;
      }
    }
