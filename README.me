      height: 100%;
      display: block;
      border: 0;
      background: #000;
    }

    .controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 15px;
    }

    button {
      border: 0;
      border-radius: 8px;
      padding: 12px 22px;
      background: #d4a900;
      color: white;
      font-size: 15px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #b88f00;
    }

    button:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    #counter {
      color: #6b5b20;
      font-weight: bold;
    }

    .comments-section {
      margin-top: 25px;
      padding: 20px;
      background: #fffdf0;
      border: 1px solid #eadb9b;
      border-radius: 10px;
    }

